---
import Default from '@astrojs/starlight/components/Sidebar.astro';
import TopicsDropdown from 'starlight-sidebar-topics-dropdown/TopicsDropdown.astro';
//@ts-expect-error - This does exist at runtime
import MobileMenuFooter from 'virtual:starlight/components/MobileMenuFooter';
import SyntaxFilter from "../syntaxes/SyntaxFilter.astro";

const isSyntaxesPage = Astro.locals.starlightRoute.id.startsWith('syntaxes');
---

{
    isSyntaxesPage ? (
        <SyntaxFilter/>
        <div class="md:sl-hidden">
            <MobileMenuFooter />
        </div>
    ) : (
        <TopicsDropdown />
        <Default><slot /></Default>
    )
}
