---
import { type Expression } from '../documentation'
import SyntaxCard from "./SyntaxCard.astro";
import SyntaxBadge from "../SyntaxBadge.astro";
import type {DocumentableCardProps} from "./DocumentableCard.astro";

interface Props {
    defaultProps: DocumentableCardProps,
    expression: Expression,
}

const { defaultProps, expression }: Props = Astro.props;
---

<SyntaxCard defaultProps={defaultProps} syntax={expression}
            data-syntax-returns={expression.returnType.name.toLowerCase()}
>
    <Fragment slot="badges">
        <SyntaxBadge
                badgeProps={{text: "Return Type", size: 'medium'}}
                entries={[{text: expression.returnType.name, cardRef: expression.returnType.id}]}
                description="The type of the value returned by this expression."
        />
    </Fragment>
</SyntaxCard>

<style is:global>
    :root {
        /* Electric Purple */
        --color-documentable-expression-light: #BF00FF;
        --color-documentable-expression-dark: #4B0082;
    }
    [data-syntax-type="Expression"] {
        --custom-badge-light: var(--color-documentable-expression-light);
        --custom-badge-dark: var(--color-documentable-expression-dark);
    }
    [data-syntax-sub-type="Section Expression"] {
        --custom-badge-light: color-mix(in oklab, var(--color-documentable-section-light), var(--color-documentable-expression-light));
        --custom-badge-dark: color-mix(in oklab, var(--color-documentable-section-dark), var(--color-documentable-expression-dark));
    }
</style>
